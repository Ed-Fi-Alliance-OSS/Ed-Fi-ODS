<Project>
  <ItemGroup>
    <!--
      Adds the patched System.Security.Cryptography.Pkcs to every project that brings in Microsoft.Data.SqlClient
      through a direct package reference, including projects added later. In a packable project the reference
      becomes a dependency of the published package. See the System.Security.Cryptography.Pkcs entry in
      Directory.Packages.props for why, and for when to remove this rule.
    -->
    <PackageReference
      Include="System.Security.Cryptography.Pkcs"
      Condition="('@(PackageReference->WithMetadataValue('Identity', 'Microsoft.Data.SqlClient'))' != ''
                  or '@(PackageReference->WithMetadataValue('Identity', 'Microsoft.EntityFrameworkCore.SqlServer'))' != ''
                  or '@(PackageReference->WithMetadataValue('Identity', 'Microsoft.Extensions.Caching.SqlServer'))' != ''
                  or '@(PackageReference->WithMetadataValue('Identity', 'AspNetCore.HealthChecks.SqlServer'))' != '')
                 and '@(PackageReference->WithMetadataValue('Identity', 'System.Security.Cryptography.Pkcs'))' == ''"
    />
  </ItemGroup>
</Project>
